# ============================================
# SANKET · AI — Environment Configuration
# ============================================

# --- App Mode ---
AI_MODE=online                          # online | airgapped

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres.hbpcldlvsgnsyaqyaosq:qAvX%2BD77%40nK6g6Z@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- Auth ---
JWT_SECRET=changeme-to-a-random-secret
JWT_EXPIRY_MINUTES=480

# --- Online LLM Providers (OpenAI / Groq) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Offline Providers ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- SIF Classification Thresholds ---
SIF_HIGH_THRESHOLD=0.75
SIF_MEDIUM_THRESHOLD=0.50
LSR_SIMILARITY_THRESHOLD=0.45

# --- Near-Miss Multiplier ---
CLUSTER_WINDOW_DAYS=7
CLUSTER_MIN_EVENTS=3

# --- Embedding Model ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
