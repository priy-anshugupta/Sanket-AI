# SANKET · AI — Frontend Environment Variables (Vercel & Production)
# Leave blank when testing locally or on Mobile Hotspot (automatically falls back to laptop IP)

# URL of your deployed FastAPI backend (e.g. Render, Railway, AWS EC2)
# NEXT_PUBLIC_API_URL=https://sanket-ai-backend.onrender.com

# WebSocket URL for Zero-Delay Control Room Alerts
# NEXT_PUBLIC_WS_URL=wss://sanket-ai-backend.onrender.com/ws/alerts

# Server-side proxy destination for Next.js rewrites (/api/* -> backend)
# BACKEND_URL=https://sanket-ai-backend.onrender.com
