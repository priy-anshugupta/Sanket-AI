# =======================================================
# SANKET · AI — Backend Dockerfile (Air-Gapped Sovereign)
# =======================================================

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (build tools & curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies (CPU-optimized PyTorch first for fast cloud builds)
COPY requirements.txt .
RUN pip install --no-cache-dir torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code and data assets
COPY backend/ ./backend/
COPY ai/ ./ai/
COPY graph/ ./graph/
COPY data/ ./data/
COPY scripts/ ./scripts/
COPY .env.example .env

# Create directories for persistent assets
RUN mkdir -p generated_pdfs uploads data/synthetic

# Expose FastAPI port
EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# Launch uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
